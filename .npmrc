# CI runs `pnpm install --frozen-lockfile`.
# pnpm >= 10 does not run dependency build scripts unless allowlisted in
# package.json `pnpm.onlyBuiltDependencies`. This is the mechanical form of
# R-11-06: nothing in the validator dependency tree may run install scripts.
# Add to the allowlist only after review.
enable-pre-post-scripts=false
